# Publik adress som används för canonical-länkar, sitemap och Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.haglindbyggare.se

# Kontaktformulär via Resend (https://resend.com). Fyll i alla tre för att aktivera utskick.
# Lämnas de tomma visar formuläret tydligt att meddelandet inte har skickats och hänvisar till telefon/e-post.
# Exempel:
#   RESEND_API_KEY=re_xxxxxxxx
#   CONTACT_TO_EMAIL=frederic@haglindbyggare.se
#   CONTACT_FROM_EMAIL="Haglind Byggare <webb@haglindbyggare.se>"   (domänen måste vara verifierad i Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
